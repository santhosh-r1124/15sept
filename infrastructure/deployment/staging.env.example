# staging environment — variable set (real values go in the platform secret store)

APP_ENV=staging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Supabase (staging project) — Session pooler connection string, port 5432.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Managed Redis
REDIS_URL=rediss://<user>:<password>@<host>:<port>/0

# Secrets — from the platform secret store
API_SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

CORS_ORIGINS=https://staging.web.example,https://staging.advocates.example

# Used to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=https://staging.web.example
PORTAL_BASE_URL=https://staging.advocates.example

# Notification emails. "console" only LOGS them - use "smtp" for real delivery, or
# verification / password-reset / notification emails never reach anyone.
EMAIL_BACKEND=smtp
EMAIL_FROM=Legal Advisor <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Embeddings / knowledge base — Google AI Studio, free tier.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Frontend (Vercel preview env)
NEXT_PUBLIC_API_BASE_URL=https://staging.api.example
NEXT_PUBLIC_APP_ENV=staging
