# production environment — variable set (real values go in the platform secret store)

APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Supabase (production project) — Session pooler connection string, port 5432.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=rediss://<user>:<password>@<host>:<port>/0

# Secrets — from the platform secret store; rotate on a schedule.
API_SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

CORS_ORIGINS=https://web.example,https://advocates.example

# Used to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=https://web.example
PORTAL_BASE_URL=https://advocates.example

# Notification emails. "console" only LOGS them - use "smtp" for real delivery, or
# verification / password-reset / notification emails never reach anyone.
EMAIL_BACKEND=smtp
EMAIL_FROM=Legal Advisor <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Video / voice consultations. Serve the apps over HTTPS (browsers require it for the camera).
# Add a coturn TURN server (infrastructure/deployment/coturn.conf.example) so calls also work for
# people behind strict firewalls; WEBRTC_RELAY_ONLY=true additionally hides IP addresses.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=turn:turn.your-domain.example:3478?transport=udp,turns:turn.your-domain.example:5349
WEBRTC_TURN_SECRET=
WEBRTC_RELAY_ONLY=false

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Embeddings / knowledge base — Google AI Studio. Free tier limits may not
# suit production ingestion volume; watch for rate/quota errors and consider
# a paid Gemini tier (still far cheaper than Voyage/OpenAI) if so.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

NEXT_PUBLIC_API_BASE_URL=https://api.example
NEXT_PUBLIC_APP_ENV=production
