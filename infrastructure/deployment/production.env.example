# production environment — variable set (real values go in the platform secret store)

APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Supabase (production project) — Session pooler connection string, port 5432.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=rediss://<user>:<password>@<host>:<port>/0

# Secrets — from the platform secret store; rotate on a schedule.
API_SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

CORS_ORIGINS=https://web.example,https://advocates.example

# Used to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=https://web.example

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

NEXT_PUBLIC_API_BASE_URL=https://api.example
NEXT_PUBLIC_APP_ENV=production
