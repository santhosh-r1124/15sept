{
  "name": "legal-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Indian Legal Advisor Bot & Advocate Connect — monorepo",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "stack:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "stack:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "stack:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "db:migrate": "cd apps/api && uv run alembic upgrade head",
    "db:revision": "cd apps/api && uv run alembic revision --autogenerate -m",
    "api:dev": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  }
}
