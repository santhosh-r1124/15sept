# =============================================================================
# apps/api — backend environment (local development)
# Copy to `.env`:  cp .env.example .env
#
# Values here override / complement the repo-root .env.example. When running the
# API inside Docker Compose the root .env is injected; this file is for running
# the API directly on the host (`uv run uvicorn ...`).
# =============================================================================

APP_ENV=development
APP_NAME=legal-platform-api
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Host-side URLs (note: localhost, not the compose service names)
DATABASE_URL=postgresql+asyncpg://legal:legal_dev_password@localhost:5432/legal_platform
DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev_password@localhost:5432/legal_platform
REDIS_URL=redis://localhost:6379/0

DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-dev-only
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Used to build links inside emails (verify-email, reset-password).
FRONTEND_BASE_URL=http://localhost:3000

# Notification emails (Phase 11). "console" logs them (free, no account); "smtp" sends through
# any SMTP server - a free Gmail/Outlook app-password account is enough to start.
EMAIL_BACKEND=console
EMAIL_FROM=Legal Advisor <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# Where advocates land; notification emails to an advocate link into the portal.
PORTAL_BASE_URL=http://localhost:3001

# LLM (used from Phase 2)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Embeddings / knowledge base (Phase 3) — Google AI Studio, free tier.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
INGESTION_MAX_SOURCE_BYTES=26214400
INGESTION_CHUNK_MAX_CHARS=1500
INGESTION_CHUNK_OVERLAP_CHARS=200

# ---- Payments / uploads / platform (Phase 8-9) ----
# "mock" always succeeds and is REFUSED when APP_ENV=production; the real gateway is an owner decision (see docs/adr/0012).
PAYMENT_PROVIDER=mock
# Platform's cut of earned advocate fees, in percent. 0 until the commission model is decided.
PLATFORM_FEE_PERCENT=0
# Matter document uploads (local disk; use object storage in production).
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
