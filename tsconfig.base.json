{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "legal-platform base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "composite": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@legal-platform/shared": ["./packages/shared/src/index.ts"],
      "@legal-platform/auth": ["./packages/auth/src/index.ts"],
      "@legal-platform/database": ["./packages/database/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo", "coverage"]
}
